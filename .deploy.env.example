# App Store Connect API Credentials
# Used by deploy.sh to archive and submit Filaire builds to TestFlight

# Path to the AuthKey_<KEY_ID>.p8 private key downloaded from App Store Connect
ASC_KEY_PATH="~/.private_keys/AuthKey_XXXXXXXXXX.p8"

# The 10-character Key ID from App Store Connect (Users and Access -> Integrations)
ASC_KEY_ID="XXXXXXXXXX"

# The Issuer ID UUID from App Store Connect
ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Apple Developer Team ID (10 characters)
DEVELOPMENT_TEAM="XXXXXXXXXX"

# App bundle identifier registered in your Apple Developer account
BUNDLE_ID="com.example.filaire"

# Optional: Specific provisioning profile name if using manual signing
# IOS_PROFILE_NAME="Filaire AppStore com.example.filaire"

# Optional: Python interpreter with PyJWT installed (defaults to python3)
# PYTHON_BIN="/path/to/venv/bin/python3"
